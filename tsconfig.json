{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals", "vite/client", "@testing-library/jest-dom"],
    "paths": { "@shared/*": ["./supabase/functions/_shared/*"] }
  },
  "include": ["src", "tests", "vite.config.ts", "supabase/functions/_shared", "supabase/functions/read-meter/parse.ts", "supabase/functions/tick/run.ts"]
}
